<Window x:Class="SistemaPOS.Desktop.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinturas El Gordo's - Panel Principal" Height="768" Width="1024"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="#F0F2F5">

    <Grid>
        <!-- Columnas: menú lateral y área principal -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- Barra superior -->
            <RowDefinition Height="*"/>
            <!-- Contenido -->
        </Grid.RowDefinitions>

        <!-- Menú lateral -->
        <Border Grid.Column="0" Grid.RowSpan="2" Background="#111111">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="Menú Principal" Foreground="Gray" FontSize="12" Margin="15,0,0,10" FontWeight="SemiBold"/>

                <Button Content="🏠 Inicio" Height="45" Background="#E5A93A" Foreground="Black" FontWeight="Bold"
                        HorizontalContentAlignment="Left" Padding="20,0,0,0" BorderThickness="0" Margin="0,5,0,0"/>
                <Button Content="🛒 Ventas" Height="45" Background="Transparent" Foreground="White"
                        HorizontalContentAlignment="Left" Padding="20,0,0,0" BorderThickness="0"/>
                <Button Content="📋 Inventario" Height="45" Background="Transparent" Foreground="White"
                        HorizontalContentAlignment="Left" Padding="20,0,0,0" BorderThickness="0"/>

                <TextBlock Text="Administración" Foreground="Gray" FontSize="12" Margin="15,20,0,10" FontWeight="SemiBold"/>
                <Button Content="💵 Caja" Height="45" Background="Transparent" Foreground="White"
                        HorizontalContentAlignment="Left" Padding="20,0,0,0" BorderThickness="0"/>
                <Button Content="⚙️ Operaciones" Height="45" Background="Transparent" Foreground="White"
                        HorizontalContentAlignment="Left" Padding="20,0,0,0" BorderThickness="0"/>
                <Button Content="📊 Finanzas" Height="45" Background="Transparent" Foreground="White"
                        HorizontalContentAlignment="Left" Padding="20,0,0,0" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- Barra superior -->
        <DockPanel Grid.Column="1" Grid.Row="0" Background="#2D2D2D" LastChildFill="False">
            <Button Content="Consultar Precio" Margin="5" Foreground="White" Background="Transparent" BorderThickness="0"/>
            <Button Content="Nueva Venta" Margin="5" Foreground="White" Background="Transparent" BorderThickness="0"/>
            <Button Content="Retirar Efectivo" Margin="5" Foreground="White" Background="Transparent" BorderThickness="0"/>
            <Button Content="Nuevo Corte" Margin="5" Foreground="White" Background="Transparent" BorderThickness="0"/>
            <TextBlock Text="Usuario: Admin1 (Administrador) - CAJA-01" 
                       Foreground="White" VerticalAlignment="Center" Margin="20,0,0,0"/>
        </DockPanel>

        <!-- Área principal -->
        <Grid Grid.Column="1" Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Tabla de productos -->
            <DataGrid Grid.Row="0" AutoGenerateColumns="False" Margin="0,0,0,10" HeadersVisibility="Column"
                      Background="White" Foreground="Black" BorderBrush="#CCCCCC" BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cód. Artículo" Binding="{Binding Codigo}" Width="120"/>
                    <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="200"/>
                    <DataGridTextColumn Header="Acabado" Binding="{Binding Acabado}" Width="120"/>
                    <DataGridTextColumn Header="Tamaño" Binding="{Binding Tamano}" Width="100"/>
                    <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="120"/>
                    <DataGridTextColumn Header="Precio Unitario" Binding="{Binding PrecioUnitario}" Width="120"/>
                    <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="100"/>
                    <DataGridTextColumn Header="Importe" Binding="{Binding Importe}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Total -->
            <TextBlock Grid.Row="1" Text="Total: $1240.00" HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontWeight="Bold" FontSize="18" Foreground="#333333"/>
        </Grid>
    </Grid>
</Window>
