<Window x:Class="SistemaPOS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acceso a Sucursal" Height="500" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F0F2F5">

    <Grid>
        <!-- Fondo con degradado -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFFFFF" Offset="0"/>
                <GradientStop Color="#E3F2FD" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Contenedor principal -->
        <Border Width="320" Padding="30" Background="White" CornerRadius="12" 
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel>

                <!-- Logo / título -->
                <TextBlock Text="🎨 PINTURAS EL GORDO'S" 
                           FontSize="20" FontWeight="Bold" Foreground="#1565C0" 
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Acceso a Sucursal" 
                           FontSize="16" Foreground="#555" 
                           HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <!-- Usuario -->
                <TextBlock Text="Usuario" Foreground="#666" FontSize="14" Margin="0,0,0,5"/>
                <TextBox x:Name="txtUsuario" Height="40" Margin="0,0,0,15" 
                         Background="#F9F9F9" BorderBrush="#CCC" BorderThickness="1"
                         VerticalContentAlignment="Center" Padding="10"
                         FontSize="14"/>

                <!-- Contraseña -->
                <TextBlock Text="Contraseña" Foreground="#666" FontSize="14" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPassword" Height="40" Margin="0,0,0,25" 
                             Background="#F9F9F9" BorderBrush="#CCC" BorderThickness="1"
                             VerticalContentAlignment="Center" Padding="10"
                             FontSize="14"/>

                <!-- Botón de inicio de sesión -->
                <Button x:Name="btnIniciarSesion" Height="45" Click="btnIniciarSesion_Click" 
                        Foreground="White" FontSize="16" FontWeight="SemiBold" Cursor="Hand" 
                        BorderThickness="0" Background="#43A047" Content="Iniciar Sesión">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Texto adicional -->
                <TextBlock Text="¿Olvidaste tu contraseña?" Foreground="#1976D2" FontSize="12" 
                           HorizontalAlignment="Center" Margin="0,15,0,0" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
