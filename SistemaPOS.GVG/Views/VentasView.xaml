<UserControl x:Class="SistemaPOS.Desktop.Views.VentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White" Height="347" Width="637">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Código de Barras:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
            <TextBox x:Name="txtCodigoBarras" Width="250" Height="35" VerticalContentAlignment="Center" FontSize="16"/>
            <Button Content="Agregar" Width="100" Margin="10,0,0,0" Background="#1A73E8" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>

        <DataGrid x:Name="dgCarrito" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="35">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding CodigoBarras}" Width="100"/>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                <DataGridTextColumn Header="Precio Unit." Binding="{Binding PrecioVenta, StringFormat=C}" Width="120"/>
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="80"/>
                <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=C}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Total:" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <TextBlock x:Name="lblTotalCesta" Text="$0.00" FontSize="36" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center" Margin="0,0,25,0"/>
                <Button Content="$ Cobrar (ESC)" Width="150" Height="50" Background="#C62828" Foreground="White" FontSize="18" FontWeight="Bold" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>